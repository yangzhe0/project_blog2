---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import Tag from "@/components/Tag.astro";

const entry = (await getCollection("pulse")).find((p: { data: { tags: string[] } }) => p.data.tags.includes("索引")) as
  | CollectionEntry<"pulse">
  | undefined;
if (!entry) throw new Error("src/content/pulse/index.md 不存在，先跑 node scripts/sync-pulse.mjs");
const { title, description, tags } = entry.data;
const { Content } = await render(entry);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  {description}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title} pageDesc={description}>
    <article
      id="article"
      class:list={[
        "mt-4 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>
  </Main>

  <Footer />
</PostLayout>
